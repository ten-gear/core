{
  "name": "tengear",
  "version": "0.0.0",
  "description": "TypeScript tensor library with a native CPU addon, optional CUDA, and WebGPU.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "benchmark:backend": "tsx project/benchmark_backend.ts",
    "prepare:tinystories": "tsx project/prepare_tinystories.ts",
    "prepare:fineweb-edu": "tsx project/prepare_fineweb_edu.ts",
    "prepare:smol-smoltalk": "tsx project/prepare_smol_smoltalk.ts",
    "train:gpt2": "tsx project/train_gpt_2.ts",
    "preview": "vite preview",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ten-gear/core.git"
  },
  "keywords": [
    "tensors",
    "autograd",
    "webgpu",
    "cuda"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ten-gear/core/issues"
  },
  "homepage": "https://github.com/ten-gear/core#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/plotly.js": "^3.0.13",
    "gif.js": "^0.2.0",
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "plotly.js": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "hyparquet": "^1.33.2",
    "hyparquet-compressors": "^1.1.3",
    "js-tiktoken": "^1.0.21"
  },
  "optionalDependencies": {
    "tengear-darwin-arm64": "0.0.0",
    "tengear-darwin-x64": "0.0.0",
    "tengear-linux-arm64-gnu": "0.0.0",
    "tengear-linux-x64-gnu": "0.0.0",
    "tengear-linux-x64-gnu-cuda12": "0.0.0",
    "tengear-win32-x64": "0.0.0",
    "tengear-win32-x64-cuda12": "0.0.0",
    "webgpu": "^0.6.2"
  }
}
